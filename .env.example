# Server
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/navigreat

# Auth
JWT_SECRET=<long-random-string>

# Zoom Meeting SDK
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (password reset, notifications)
EMAIL_USER=
EMAIL_PASS=

# Paytm (leave empty or set MOCK_PAYTM=true for sandbox/mock payments)
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_ENV=staging
PAYTM_CALLBACK_URL=http://localhost:5000/api/payment/callback
MOCK_PAYTM=true

# Testing only — enables /api/dev/verify-me. Never true in production.
ALLOW_DEV_ROUTES=false
